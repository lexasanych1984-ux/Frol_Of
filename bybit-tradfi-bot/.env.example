# ── Bybit TradFi MT5 credentials ─────────────────────────────────────────────
# Возьми из MT5-терминала после создания ДЕМО-счёта.
# ВАЖНО: MASTER password, не Investor (Investor = только чтение).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Путь к terminal64.exe (если пусто — MetaTrader5 попробует найти сам)
MT5_TERMINAL_PATH=

# ── Safety switches ──────────────────────────────────────────────────────────
# demo  = виртуальные деньги (Bybit TradFi demo). Начинай здесь.
# live  = реальные средства. Меняй только осознанно.
BYBIT_ENV=

# true  = только логировать намерения, НЕ слать ордера (защитная заглушка).
# false = реально исполнять (на demo — виртуально, на live — реально).
DRY_RUN=

# ── Signal source: cdp | http ────────────────────────────────────────────────
# cdp  = читать сработавшие алерты из TradingView Desktop через CDP (локально).
# http = слушать локальный loopback-приёмник 127.0.0.1 (тест / будущий VPS).
SIGNAL_SOURCE=
CDP_PORT=
HTTP_HOST=
HTTP_PORT=
# Общий секрет для http-приёмника (защита от случайных запросов на localhost)
HTTP_SHARED_SECRET=

# ── Облачный store-and-forward буфер (резервный канал сигналов) ───────────────
# Убирает главный узел отказа: CDP видит алерт только пока бот+TV запущены; при
# простое сигнал теряется навсегда. Облачный приёмник (Cloudflare Worker + D1,
# см. cloud/README.md) принимает webhook от TradingView серверно и хранит 7 дней;
# бот его ОПРАШИВАЕТ (pull) — никаких входящих портов на домашнем ПК.
# Включается, ТОЛЬКО если заданы и URL, и токен. Работает ПАРАЛЛЕЛЬНО с cdp/http.
WEBHOOK_PULL_URL=
WEBHOOK_TOKEN=
                            #   сгенерировать: python -c "import secrets;print(secrets.token_urlsafe(32))"
WEBHOOK_POLL_SEC=
WEBHOOK_PULL_LIMIT=
WEBHOOK_STALE_SEC=
# Защита протухших сигналов (дефолты; per-strategy — в config.yaml signal_freshness):
WEBHOOK_ENTRY_MAX_AGE_SEC=
WEBHOOK_MANAGE_MAX_AGE_SEC=

# ── Telegram-уведомления мониторинга живости ─────────────────────────────────
# Принцип: молчание = авария. Бот шлёт в Telegram переходы OK↔FAIL проверок,
# суточную сводку и сообщения о старте/остановке. Внешний watchdog (Планировщик)
# шлёт тревогу, если процесс бота упал целиком.
#
# Вариант A — вписать значения прямо сюда:
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Вариант B — НЕ дублировать секреты: указать путь к .env, где токен/чат уже
# есть (напр. бот из D:\MY\Crypto\AI agent). Берётся, только если A пуст.
TELEGRAM_ENV_FILE=
# Префикс ко всем сообщениям (отличать этот источник в общем чате):
TELEGRAM_PREFIX=

# ── Автосинк журнала сделок в Notion ─────────────────────────────────────────
# Бот сам пишет КАЖДУЮ закрытую сделку строкой в базу «Сделки бота» (дашборд
# доходности), идемпотентно по position_id — чтобы база не пустела молча.
# Включается, ТОЛЬКО если задан NOTION_TOKEN. Настройка (разово):
#   1. https://www.notion.so/my-integrations → New integration (internal) →
#      скопировать «Internal Integration Secret» (начинается с ntn_/secret_);
#   2. открыть страницу «Торговый бот — статистика» в Notion → ••• → Connections →
#      добавить свою интеграцию (иначе бот увидит 404/нет доступа к базе);
#   3. вписать секрет ниже. Проверка: python run.py sync-notion
NOTION_TOKEN=
NOTION_DB_ID=
NOTION_SYNC_SEC=
NOTION_HISTORY_DAYS=
# Страница для PNG-графиков доходности. Бесплатный тариф Notion разрешает лишь 1
# нативный чарт на воркспейс, поэтому бот рисует графики картинками (matplotlib) и
# кладёт на эту страницу, пересобирая её целиком. Пусто → графики выключены.
# Создай пустую страницу в Notion, расшарь ей интеграцию, вставь её id сюда.
NOTION_CHARTS_PAGE_ID=

# ── Параметры мониторинга (можно не трогать — значения по умолчанию) ──────────
HEALTH_CHECK_INTERVAL_SEC=
HEALTH_CDP_STALE_SEC=
HEALTH_ANTISPAM_SEC=
HEALTH_DAILY_SUMMARY_AT=
#   окна работы бота: если время попадёт на простой (бот не круглосуточный), сводка
#   уйдёт сразу после старта с нулями — формально придёт, но пользы не даст.
HEALTH_PID_FILE=

# ── Отчёт эджа и тревоги о деградации (см. docs/REPORTING.md) ─────────────────
# Сравнение факта демо с коридорами бэктеста (expectations.yaml). Всё опционально.
EXPECTATIONS_FILE=
EXEC_LOG_FILE=
REPORTS_DIR=
REPORT_HISTORY_DAYS=
RISK_OVERSHOOT_PP=
                                      # > этого (п.п.). Пусто → из expectations.yaml (0.3)
EDGE_CHECK_INTERVAL_SEC=
