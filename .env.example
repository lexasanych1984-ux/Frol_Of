# ── Bybit TradFi MT5 credentials ─────────────────────────────────────────────
# Возьми из MT5-терминала после создания ДЕМО-счёта.
# ВАЖНО: MASTER password, не Investor (Investor = только чтение).
MT5_LOGIN=
MT5_PASSWORD=
MT5_SERVER=
# Путь к terminal64.exe (если пусто — MetaTrader5 попробует найти сам)
MT5_TERMINAL_PATH=

# ── Safety switches ──────────────────────────────────────────────────────────
# demo  = виртуальные деньги (Bybit TradFi demo). Начинай здесь.
# live  = реальные средства. Меняй только осознанно.
BYBIT_ENV=demo

# true  = только логировать намерения, НЕ слать ордера (защитная заглушка).
# false = реально исполнять (на demo — виртуально, на live — реально).
DRY_RUN=true

# ── Signal source: cdp | http ────────────────────────────────────────────────
# cdp  = читать сработавшие алерты из TradingView Desktop через CDP (локально).
# http = слушать локальный loopback-приёмник 127.0.0.1 (тест / будущий VPS).
SIGNAL_SOURCE=cdp
CDP_PORT=9222
HTTP_HOST=127.0.0.1
HTTP_PORT=8787
# Общий секрет для http-приёмника (защита от случайных запросов на localhost)
HTTP_SHARED_SECRET=
